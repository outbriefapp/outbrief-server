# Nothing here is required: the server starts without a .env. Set these in the environment (or copy
# this file to .env) only to change a default.

# PORT=8787
# Deployment platforms inject the database URL. The default is the local docker MySQL
# ("some-mysql"); create its databases and user with db/bootstrap.sql first.
# OUTBRIEF_DATABASE_URL=mysql://outbrief:outbrief_local@127.0.0.1:3306/outbrief
# true: anyone may create an account (public cloud, rate limited). Default false: the server prints
# a one-time claim code on start, the first account needs it, and new accounts are off after that.
# OUTBRIEF_OPEN_SIGNUP=false
# Integration tests TRUNCATE tables here; must end with _test.
# OUTBRIEF_TEST_DATABASE_URL=mysql://outbrief:outbrief_local@127.0.0.1:3306/outbrief_test
